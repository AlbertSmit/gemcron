{
  "name": "gemini-task-manager",
  "version": "1.0.0",
  "description": "Terminal UI for managing scheduled Gemini CLI tasks",
  "type": "module",
  "bin": {
    "gemcron": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.tsx",
    "build": "tsc",
    "start": "node dist/cli.js",
    "task": "tsx src/runner.ts"
  },
  "keywords": [
    "gemini",
    "cli",
    "cron",
    "terminal",
    "ink"
  ],
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "cron-parser": "^4.9.0",
    "ink": "^5.0.1",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  }
}
